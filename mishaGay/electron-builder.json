{
  "appId": "com.rental.app",
  "publish": [
    {
      "provider": "github",
      "owner": "1abama1",
      "repo": "kyrgyz-prokat-front"
    }
  ],
  "productName": "Rental Desktop App",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "resources/**/*",
    "src/assets/logo.png",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "src/assets/logo.png",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}